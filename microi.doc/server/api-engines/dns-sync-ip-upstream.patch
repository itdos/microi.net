+++ b/dns_sync_ip.js
@@ -0,0 +1,8 @@
+/*
+ * V8 ApiEngine
+ * ApiEngineKey: dns_sync_ip
+ * Version: v1.0.1
+ * Function:
+ * - 定时读取固定公网客户端IP服务后按原有目标同步DNS；上游HTTP状态、正文、业务码及公网IPv4校验失败时在任何DNS写入前返回。CheckIpOnly=true/1仅验证当前API节点公网IP，不写DNS、缓存或清理日志；保留既有目标、凭据和缓存规则。
+ */
+
@@ -11,10 +19,41 @@
-//修改为从阿里云服务器获取IP
-// var clientIPResult = V8.Method.GetClientIP();
-var clientIPResult = V8.Http.Post({
-  Url : 'https://api.nbweixin.cn/apiengine/get-client-ip'
-});
-clientIPResult = JSON.parse(clientIPResult);
-if(clientIPResult.Code != 1){
-  return clientIPResult;
