{
	"name": "microi-docs",
	"version": "1.0.0",
	"description": "Microi吾码开源 AI 开发框架官网与官方文档",
	"type": "module",
	"author": {
		"name": "Microi风闲",
		"email": "359681091@qq.com",
		"url": "https://lisaisai.blog.csdn.net/?type=blog"
	},
	"license": "MIT",
	"homepage": "https://microi.net/",
	"scripts": {
		"generate:architecture": "node scripts/generate-ai-platform-architecture.mjs",
		"check:links": "node scripts/check-dead-links.mjs",
		"check:sidebar": "node scripts/check-sidebar-coverage.mjs && node --test tests/sidebar-system-engine-grouping.test.mjs",
		"check:repositories": "node scripts/check-open-source-links.mjs",
		"check:readability": "node scripts/check-doc-readability.mjs",
		"audit:visual": "node scripts/check-doc-readability.mjs --report",
		"check:content": "npm run check:links && npm run check:sidebar && npm run check:repositories && npm run check:readability && npm run test:microservice-docs && npm run test:image-lightbox && npm run test:ai-media && npm run test:ai-capability-docs && npm run test:homepage && npm run test:training-deck && npm run test:architecture && npm run test:app-preview && npm run test:update-log && npm run test:v8-first-routes && npm run test:ocr-docs && npm run test:vision-docs",
		"check:seo": "node scripts/check-seo.mjs",
		"check:theme": "node scripts/check-default-dark.mjs",
		"test:app-preview": "node --test docs/.vitepress/theme/utils/app-preview-url.test.mjs docs/.vitepress/theme/utils/upload-resource-url.test.mjs docs/.vitepress/theme/utils/app-changelog.test.mjs tests/uniapp-preview-mode.test.mjs tests/ai-app-card-experience.test.mjs",
		"test:update-log": "node --test tests/update-log-scope-banner.test.mjs",
		"test:v8-first-routes": "node --test tests/v8-first-route-docs.test.mjs",
		"test:ocr-docs": "node --test tests/ocr-engine-docs.test.mjs",
		"test:vision-docs": "node --test tests/vision-engine-docs.test.mjs",
		"test:site-api": "node --test tests/site-api-base.test.mjs",
		"test:nuget": "node --test tests/nuget-downloads.test.mjs",
		"test:microservice-docs": "node --test tests/microservice-docs.test.mjs",
		"test:image-lightbox": "node --test tests/doc-image-lightbox.test.mjs",
		"test:ai-media": "node --test tests/ai-media-docs.test.mjs",
		"test:ai-capability-docs": "node --test tests/ai-capability-docs.test.mjs",
		"test:homepage": "node --test tests/homepage-positioning.test.mjs",
		"test:training-deck": "node --test tests/training-syllabus-deck.test.mjs",
		"test:architecture": "node --test tests/ai-platform-architecture.test.mjs",
		"test:marketplace": "node --test tests/marketplace-query-state.test.mjs tests/site-session.test.mjs",
		"docs:dev": "npm run check:content && vitepress dev docs --host",
		"dev": "npm run check:content && vitepress dev docs --host",
		"docs:build": "npm run check:content && vitepress build docs && npm run check:theme && npm run check:seo",
		"build": "npm run check:content && vitepress build docs && npm run check:theme && npm run check:seo",
		"docs:preview": "vitepress preview docs"
	},
	"devDependencies": {
		"@types/node": "^25.0.9",
		"@types/three": "^0.183.1",
		"markdown-it-custom-attrs": "^1.0.2",
		"sass": "^1.97.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitepress": "1.6.4",
		"vue": "^3.5.26"
	},
	"dependencies": {
		"@alicloud/alimt20181012": "^1.4.2",
		"@alicloud/openapi-client": "^0.4.15",
		"@alicloud/pop-core": "^1.8.0",
		"marked": "^17.0.1",
		"p-limit": "^7.2.0",
		"three": "^0.183.2"
	}
}
