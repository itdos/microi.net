.mci-bottom-dock {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 112rpx;
  gap: 16rpx;
  align-items: center;
  box-sizing: border-box;
  background: linear-gradient(180deg, rgba(245, 251, 255, 0), rgba(245, 251, 255, .92) 35%, #f5fbff 100%);
  pointer-events: none;
}

.mci-bottom-dock--without-ai {
  grid-template-columns: minmax(0, 1fr);
}

.mci-bottom-dock__ai-slot {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid rgba(8, 125, 168, .22);
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 8rpx 30rpx rgba(15, 49, 66, .16);
  transition: transform 150ms ease, box-shadow 150ms ease;
  pointer-events: auto;
}

.mci-bottom-dock__ai-slot--pressed {
  transform: scale(.93);
  box-shadow: 0 4rpx 16rpx rgba(15, 49, 66, .14);
}

.mci-bottom-dock__ai-ring {
  position: absolute;
  inset: 5rpx;
  border: 2rpx solid rgba(24, 166, 184, .22);
  border-radius: 50%;
  pointer-events: none;
  animation: mciAiSlotPulse 2.8s ease-in-out infinite;
}

.mci-bottom-dock__ai-robot {
  position: relative;
  z-index: 1;
  width: 76rpx;
  height: 76rpx;
  margin-top: -7rpx;
  pointer-events: none;
}

.mci-bottom-dock__ai-label {
  position: absolute;
  z-index: 2;
  right: 0;
  bottom: 5rpx;
  left: 0;
  color: #087da8;
  font-size: 18rpx;
  line-height: 22rpx;
  font-weight: 800;
  text-align: center;
  pointer-events: none;
}

@keyframes mciAiSlotPulse {
  0%, 100% { transform: scale(.96); opacity: .45; }
  50% { transform: scale(1); opacity: .9; }
}

.mci-bottom-dock__nav {
  min-width: 0;
  height: 112rpx;
  display: flex;
  align-items: stretch;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid rgba(15, 18, 30, .1);
  border-radius: 58rpx;
  box-shadow: 0 8rpx 30rpx rgba(15, 49, 66, .13);
  pointer-events: auto;
}

.mci-bottom-dock__item {
  flex: 1;
  min-width: 0;
  min-height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3rpx;
  transition: transform 150ms ease, color 150ms ease, background-color 150ms ease;
}

.mci-bottom-dock__item--active {
  font-weight: 700;
}

.mci-bottom-dock__item--pressed {
  background: rgba(8, 125, 168, .06);
  transform: scale(.92);
}

.mci-bottom-dock__icon {
  width: 42rpx;
  height: 42rpx;
  flex: none;
}

.mci-bottom-dock__label {
  max-width: 100%;
  font-size: 20rpx;
  line-height: 25rpx;
  font-weight: 600;
  white-space: nowrap;
}

@media (prefers-reduced-motion: reduce) {
  .mci-bottom-dock__item {
    transition: none;
  }

  .mci-bottom-dock__ai-slot {
    transition: none;
  }

  .mci-bottom-dock__ai-ring {
    animation: none;
  }
}
