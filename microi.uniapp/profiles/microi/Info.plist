<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>NSAppTransportSecurity</key>
    <dict>
      <key>NSAllowsArbitraryLoads</key>
      <false/>
    </dict>
    <key>NSCameraUsageDescription</key>
    <string>用于用户主动拍摄表单、现场或业务附件</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>用于用户主动选择并上传图片或视频附件</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>用于将用户明确选择的业务图片保存到相册</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>用于用户主动录制业务语音或带声音的视频附件</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>用于用户主动执行拜访、移动打卡、地图选点或现场服务</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>用于用户主动开启的外勤、拜访或现场任务在切换到后台后继续记录必要的位置；未启用相关功能时不会访问定位</string>
  </dict>
</plist>
