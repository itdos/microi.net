## V8.MongoDb — MongoDB 操作

所有方法第一个参数为数据库名，第二个为集合名。

```js
V8.MongoDb.Insert('mydb', 'users', { name: '张三', age: 25 });
var doc = V8.MongoDb.Find('mydb', 'users', { name: '张三' });
var docs = V8.MongoDb.FindMany('mydb', 'users', { age: { $gt: 18 } });
V8.MongoDb.Update('mydb', 'users', { name: '张三' }, { $set: { age: 26 } });
V8.MongoDb.Delete('mydb', 'users', { name: '张三' });
var count = V8.MongoDb.Count('mydb', 'users', {});
var agg = V8.MongoDb.Aggregate('mydb', 'users', [{ $group: { _id: '$city', total: { $sum: 1 } } }]);
```

---

## V8.Method — 内置方法

```js
var token = V8.Method.GetCurrentToken();          // 获取当前用户Token
V8.Method.RefreshLoginUser(userId);                // 刷新用户登录缓存
var url = V8.Method.GetPrivateFileUrl(fileId);     // 获取私有文件临时URL
V8.Method.AddSysLog('标题', '内容', '分类');       // 写系统日志
var guid = V8.Method.NewGuid();                    // 新GUID
var snowId = V8.Method.SnowflakeId();              // 雪花ID
var oldWhere = V8.Method.ParseWhere(V8.Param._Where); // 新版→旧版Where转换
```

