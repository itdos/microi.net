## V8.EncryptHelper — 加密

```js
var md5 = V8.EncryptHelper.MD5Encrypt('text');
var sha256 = V8.EncryptHelper.SHA256Encrypt('text');
var hmac = V8.EncryptHelper.HmacSha256(key, data);
var encrypted = V8.EncryptHelper.AESEncrypt('text', 'key');
var decrypted = V8.EncryptHelper.AESDecrypt(encrypted, 'key');
var desEnc = V8.EncryptHelper.DESEncrypt('text', 'key');
var desDec = V8.EncryptHelper.DESDecrypt(desEnc, 'key');
```

---

## V8.Base64

```js
var encoded = V8.Base64.Encode('Hello');  // SGVsbG8=
var decoded = V8.Base64.Decode('SGVsbG8='); // Hello
```

