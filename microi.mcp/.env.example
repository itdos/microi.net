# Microi MCP Server 环境变量配置

# [必填] Microi 后端 API 地址
MICROI_API_URL=https://api.example.com

# [必填] 登录账号
MICROI_USERNAME=admin

# [必填] 登录密码（明文，MCP 内部会自动 RSA 加密）
MICROI_PASSWORD=your_password

# [可选] 应用标识（OsClient），留空则使用后端默认
MICROI_OS_CLIENT=

# [可选] 自定义 RSA 公钥（PEM 格式），留空则使用 Microi 默认公钥
# MICROI_RSA_PUBLIC_KEY=

# [可选] 传输模式：stdio（默认，本地使用）| sse（Docker / 远程部署）
MCP_TRANSPORT=stdio

# [可选] SSE 模式端口号（默认 3000）
MCP_PORT=3000
