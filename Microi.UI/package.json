{
  "name": "@microi/mci-ui",
  "version": "0.1.0",
  "private": true,
  "description": "MCI-UI for Microi Vue3 websites and uni-app mobile projects.",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "**/*.vue"
