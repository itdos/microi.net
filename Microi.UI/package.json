{
  "name": "@microi/mci-ui",
  "version": "0.1.0",
  "private": true,
  "description": "MCI-UI for Microi Vue3 websites and uni-app mobile projects.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "microi",
    "mci-ui",
    "vue3",
    "uni-app",
    "design-system",
    "theme"
  ],
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "check": "node --check src/theme/runtime.js && node --check src/web/index.js && node --check src/uniapp/index.js",
    "pack:check": "npm pack --dry-run"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "**/*.vue"
  ],
  "exports": {
    ".": "./src/web/index.js",
    "./web": "./src/web/index.js",
    "./uniapp": "./src/uniapp/index.js",
    "./theme": "./src/theme/index.css",
    "./tokens": "./src/theme/tokens.css",
    "./runtime": "./src/theme/runtime.js"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  }
}
