[Unit]
Description=Microi host authentication guard
After=network.target docker.service systemd-journald.service
Wants=network.target

[Service]
Type=simple
User=root
Group=root
UMask=0077
RuntimeDirectory=microi-auth-guard
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
StateDirectory=microi-auth-guard
StateDirectoryMode=0700
ExecStartPre=/usr/bin/python3 -B /opt/microi-auth-guard/daemon.py --check
ExecStart=/usr/bin/python3 -B /opt/microi-auth-guard/daemon.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# iptables 必须使用与 Docker 共用的 /run/xtables.lock；不可另起私有锁。
ReadWritePaths=/run /var/lib/microi-auth-guard
# 需要宿主 netfilter 和只读 SSH 日志；不使用 PrivateNetwork 隔离到无效网络命名空间。
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
MemoryMax=256M
TasksMax=160

[Install]
WantedBy=multi-user.target
