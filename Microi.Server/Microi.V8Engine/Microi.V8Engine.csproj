<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- dotnet build -c Release -->
    <!-- 若升级此类库版本号，必须同时升级Microi.net版本号 -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <OutputType>Library</OutputType>
    <Authors>Microi</Authors>
    <Company>www.microi.net</Company>
    <Description>开源低代码平台-Microi吾码，V8引擎注入。此类库开源，官网：https://microi.net</Description>
    <Copyright>Copyright 2009-2026 microi.net</Copyright>
    <PackageProjectUrl>https://www.microi.net</PackageProjectUrl>
    <PackageIcon>microi-blue-256.png</PackageIcon>
    <PackageTags>低代码,LowCode,V8,V8引擎,JavaScript,Microi吾码,Microi,Microi.net,iTdos,MicroiOS,Dos,Dos.ORM</PackageTags>
    <PackageReleaseNotes>开源低代码平台-Microi吾码，V8引擎注入。此类库开源，官网：https://microi.net</PackageReleaseNotes>
    <Version>6.9.0</Version>
    <AssemblyVersion>6.9.0</AssemblyVersion>
    <FileVersion>6.9.0</FileVersion>
    <RestorePackages>true</RestorePackages>
    <IsPackable>true</IsPackable>
    <Configurations>Release;Debug</Configurations>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Dos.Common/Dos.Common.csproj" />
    <ProjectReference Include="../Microi.Core/Microi.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AlibabaCloud.SDK.Alidns20150109" Version="4.5.0" />
    <PackageReference Include="AlibabaCloud.SDK.ESA20240910" Version="3.10.0" />
    <PackageReference Include="AlipaySDKNet.OpenAPI" Version="3.0.57" />
    <PackageReference Include="AlipaySDKNet.Standard" Version="4.9.1234" />
    <!-- Force the current fixed log4net release across payment SDK transitive dependencies. -->
    <PackageReference Include="log4net" Version="3.3.2" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <!--
      最新 Alipay SDK 仍传递 Portable.BouncyCastle 1.8.x。它与官方新包导出相同类型，
      但 Microi 只使用新版实现，因此保留依赖解析、排除旧程序集的编译和运行时资产。
    -->
    <PackageReference Include="Portable.BouncyCastle" Version="1.9.0"
                      ExcludeAssets="compile;runtime"
                      PrivateAssets="all" />
    <!-- DWG/DXF 文件处理库 -->
    <PackageReference Include="ACadSharp" Version="3.6.35" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Resource\microi-blue-256.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

</Project>
