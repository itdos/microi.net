  "ActionOverrides": {
    "SysUserController.Login": {
      "Disposition": "BootstrapIdentity",
      "Target": "native password/captcha/DiyToken bootstrap plus optional platform_auth_login_event",
      "Reason": "全新数据库尚未安装应用时仍必须能够使用 admin 登录并进入应用商城。"
    },
    "SysUserController.SmsLogin": {
      "Disposition": "ManagedBusinessFacade",
      "Target": "app.microi.saas-engine ApiEngine:platform_auth_sms_login",
      "Reason": "短信注册、角色分配、租户信息与登录响应属于可升级业务编排。"
    },
    "SysUserController.AddSysUser": {
      "Disposition": "ManagedBusinessFacade",
      "Target": "FormEngine plus app.microi.saas-engine policy engine"
    },
    "SysUserController.UptSysUser": {
      "Disposition": "ManagedBusinessFacade",
      "Target": "FormEngine plus app.microi.saas-engine policy engine"
    },
    "SysUserController.DelSysUser": {
      "Disposition": "ManagedBusinessFacade",
      "Target": "FormEngine plus app.microi.saas-engine policy engine"
    },
    "SsoController": {
      "Disposition": "ProtocolGateway",
      "Target": "app.microi.sso Managed ApiEngines",
      "NativeBoundary": [
        "OIDC/SAML/CAS message parsing and signature validation",
        "redirect and raw protocol response",
        "opaque one-time protocol tickets",
        "tenant signing keys and DiyToken trusted atoms"
      ],
      "ManagedApiEngines": [
        "sso_capabilities",
        "sso_legacy_capabilities",
        "sso_connection_runtime",
        "sso_resolve_federated_identity",
        "sso_protocol_event",
        "sso_event_hook",
        "sso_outbound_claims",
        "sso_complete_login",
        "sso_rotate_client_secret",
        "sso_legacy_token_login",
        "sso_user_runtime"
      ],
      "RemovedNativeActions": [
        "Capabilities",
        "LegacyCapabilities",
        "CompleteLogin",
        "RotateClientSecret",
        "SysUserController.SsoPengrui"
      ]
    },
    "WeChatContentSecurityController.Callback": {
      "Disposition": "ProtocolGateway",
      "Target": "C# signature/AES gateway plus Managed callback ApiEngine"
    },
    "MarketplaceSourceController": {
      "Disposition": "ProtocolGateway",
      "Target": "app.microi.store Managed ApiEngines"
    }
  }
