{
  "AppSettings": {
    "//" : "OsClient、OsClientType、OsClientNetwork、OsClientDbConn 必填",
    "OsClient": "iTdos",
    "OsClientType": "Product",
    "OsClientNetwork": "Internal",
    "OsClientDbType": "MySql",
    "OsClientDbConn": "",
    "OsClientRedisHost": "",
    "OsClientRedisPort": "",
    "OsClientRedisPwd": "",
    "OsClientRedisDataBase": "5",
    "OsClientDbMongoConn": ""
  },
  "DevLoginBypass": {
    "//": "本地开发/自动化测试旁路。默认关闭。即使设置 Enabled=true，也只允许 Development 环境的本机回环请求生效。任何自动化方式都只允许跳过验证码，必须继续校验真实账号密码。远端自动化建议开启 sys_config.AutoTestSkipCaptcha 后传 _AutomationTestLogin=true。",
    "Enabled": false,
    "SkipCaptcha": true,
    "OnlyLoopback": true,
    "DefaultAccount": "admin",
    "DefaultPassword": "",
    "Accounts": [
      {
        "OsClient": "testTenantKey",
        "Account": "admin",
        "Password": ""
      }
    ]
  },
  "Security": {
    "Description": "内部认证密钥配置，不属于普通安装调参。登录 RSA 仅用于避免密码在请求体中直接显示，不能替代 HTTPS。AuthSecret 为空、等于租户Key、长度过短、重复或安全轮换版本变化时，程序会在加载 sys_osclients 时自动生成强随机 JWT 密钥并写回数据库。普通OAuth返回域名等业务配置请在SaaS引擎维护。",
    "LoginRsaPrivateKey": "",
    "LoginRsaPrivateKeyPath": "",
    "LoginRsaPublicKey": "",
    "AuthSecretRotateVersion": "2026-07-09-official-security-v2"
  },
  "LicenseSecurity": {
    "Description": "内嵌官方RSA公钥是License唯一信任根。公钥的PEM、DER Base64、绝对文件路径三种显式来源只能选择一种，且只能提供与内嵌官方公钥身份完全相同的副本；冲突、无效或身份不匹配时失败关闭。私钥只允许官方签发中心受限挂载，程序会导出其公钥并与内嵌官方公钥固定时间比较，任意客户自生成私钥不能建立签发身份。",
    "PublicKey": "",
    "PublicKeyBase64": "",
    "PublicKeyPath": "",
    "PrivateKeyPath": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "Microsoft": "Error",
      "Microsoft.AspNetCore": "Error",
      "Quartz": "Error",
      "IdentityServer4": "Error",
      "Microsoft.AspNetCore.DataProtection": "Error",
      "Microsoft.AspNetCore.HttpsPolicy": "Error",
      "Microsoft.AspNetCore.Hosting": "Error",
      "Microsoft.AspNetCore.StaticAssets": "Error"
    }
  },
  "StaticWebAssets": {
    "Enabled": true
  },
  "AllowedHosts": "*"
}
