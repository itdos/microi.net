<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <Authors>Microi</Authors>
    <Company>microi.net</Company>
    <Description>Microi 吾码 SSO 身份联邦插件，提供 OIDC、OAuth2、SAML2、CAS 可信协议原子；业务编排由官方接口引擎实现。</Description>
    <Copyright>Copyright 2009-2026 microi.net</Copyright>
    <PackageProjectUrl>https://microi.net</PackageProjectUrl>
    <PackageIcon>microi-blue-256.png</PackageIcon>
    <PackageTags>Microi,SSO,OIDC,OAuth2,SAML2,CAS,V8,接口引擎</PackageTags>
    <PackageReleaseNotes>Microi 吾码 SSO 身份联邦可信协议插件。</PackageReleaseNotes>
    <Version>8.1.7</Version>
    <AssemblyVersion>8.1.7</AssemblyVersion>
    <FileVersion>8.1.7</FileVersion>
    <RestorePackages>true</RestorePackages>
    <IsPackable>true</IsPackable>
    <Configurations>Release;Debug</Configurations>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- SAML2 只实现协议签名、验签和标准报文，不注册 MVC Controller。 -->
    <PackageReference Include="ITfoxtec.Identity.Saml2" Version="4.20.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
  </ItemGroup>

  <!-- SSO 协议原子复用 Microi 会话、缓存、HTTP 与接口引擎运行时。 -->
  <ItemGroup Condition="'$(MicroiNetExists)' == 'true'">
    <ProjectReference Include="..\Microi.net\Microi.net.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(MicroiNetExists)' != 'true'">
    <PackageReference Include="Microi.net" Version="$(MicroiNetVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Dos.Common\Dos.Common.csproj" />
    <ProjectReference Include="..\Microi.Core\Microi.Core.csproj" />
    <!-- 公开方案只通过 NuGet 消费闭源 Microi.net；打包资源也必须来自公开项目。 -->
    <None Include="..\Microi.Core\Resource\microi-blue-256.png"
          Link="Resource\microi-blue-256.png"
          Pack="true"
          PackagePath="" />
  </ItemGroup>
</Project>
