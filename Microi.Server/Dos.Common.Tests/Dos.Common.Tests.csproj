<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dos.Common\Dos.Common.csproj" />
    <ProjectReference Include="..\Microi.V8Engine\Microi.V8Engine.csproj" />
    <ProjectReference Include="..\Microi.Upgrade\Microi.Upgrade.csproj" />
    <!-- 私有 Microi.net 子仓存在时启用端到端租户边界回归；开源仓单独检出仍可构建。 -->
    <ProjectReference Include="..\Microi.net\Microi.net.csproj"
                      Condition="Exists('..\Microi.net\Microi.net.csproj')" />
    <ProjectReference Include="..\Microi.Spider\Microi.Spider.csproj"
                      Condition="Exists('..\Microi.net\Microi.net.csproj')" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('..\Microi.net\Microi.net.csproj')">
    <Compile Remove="FormEngineTenantBoundaryTests.cs" />
    <Compile Remove="TokenRotationSecurityTests.cs" />
    <Compile Remove="DataSourceEngineAuthorizationTests.cs" />
    <Compile Remove="TenantEngineIsolationTests.cs" />
    <Compile Remove="SpiderSecurityBoundaryTests.cs" />
    <Compile Remove="LicenseKeyTrustTests.cs" />
  </ItemGroup>

</Project>
