<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- dotnet build -c Release -->
    <!-- 若升级此类库版本号，必须同时升级Microi.net版本号 -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <OutputType>Library</OutputType>
    <Authors>Microi</Authors>
    <Company>www.microi.net</Company>
    <Description>开源低代码平台-Microi吾码，核心库。此类库开源，官网：https://microi.net</Description>
    <Copyright>Copyright 2009-2026 microi.net</Copyright>
    <PackageProjectUrl>https://microi.net</PackageProjectUrl>
    <PackageIcon>microi-blue-256.png</PackageIcon>
    <PackageTags>低代码,LowCode,V8,V8引擎,JavaScript,Microi吾码,Microi,Microi.net,iTdos,MicroiOS,Dos,Dos.ORM</PackageTags>
    <PackageReleaseNotes>开源低代码平台-Microi吾码，核心库。此类库开源，官网：https://microi.net</PackageReleaseNotes>
    <Version>7.0.7</Version>
    <AssemblyVersion>7.0.7</AssemblyVersion>
    <FileVersion>7.0.7</FileVersion>
    <RestorePackages>true</RestorePackages>
    <IsPackable>true</IsPackable>
    <Configurations>Release;Debug</Configurations>
    <!-- 禁用NuGet包警告 -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <!-- 只在Release模式生成NuGet包 -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.14.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.21.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.21.0" />
    <PackageReference Include="MongoDB.Bson" Version="3.10.0" />
    <!-- Pin the fixed XML signature implementation for legacy ASP.NET Core 2.x transitive dependencies. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
    <!-- MQTTnet 5.x only targets net8.0+; 4.3.7 is the latest netstandard2.1-compatible release. -->
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <PackageReference Include="StackExchange.Redis" Version="3.0.17" />
    <PackageReference Include="Ulid" Version="1.4.1" />
    <ProjectReference Include="../Dos.Common/Dos.Common.csproj" />
    <ProjectReference Include="../Dos.ORM/Dos.ORM.csproj" />
    <PackageReference Include="AlibabaCloud.SDK.Alimt20181012" Version="2.4.2" />
    <PackageReference Include="AlibabaCloud.SDK.Dysmsapi20170525" Version="4.4.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Resource\microi-blue-256.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Logic/" />
    <Folder Include="SaaSEngine/" />
    <Folder Include="Resource\" />
    <Folder Include="Token/" />
  </ItemGroup>
</Project>
