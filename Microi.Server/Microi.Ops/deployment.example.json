{
  "id": "microi-production", "name": "吾码生产平台",
  "platformApiBase": "https://api.example.com", "platformOsClient": "your-osclient",
  "watchtowerName": "",
  "allowedImageRepositories": ["registry.cn-hangzhou.aliyuncs.com/microios/microi-api", "registry.cn-hangzhou.aliyuncs.com/microios/microi-client-dev"],
  "services": [
    {
      "name": "microi-api", "role": "api", "repository": "registry.cn-hangzhou.aliyuncs.com/microios/microi-api", "tag": "latest",
      "composeProject": "microi", "composeService": "microi-api", "composeDirectory": "/microi/compose/platform",
