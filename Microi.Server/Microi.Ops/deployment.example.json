      "allowAutomatic": false, "imageRollbackCompatible": false, "readyTimeoutSeconds": 300
    },
    {
      "name": "microi-client", "role": "web", "repository": "registry.cn-hangzhou.aliyuncs.com/microios/microi-client-dev", "tag": "latest",
      "composeProject": "microi", "composeService": "microi-client", "composeDirectory": "/microi/compose/platform",
      "requireDockerHealth": false, "readyUrl": "https://web.example.com/", "readyContains": "<html",
      "allowAutomatic": true, "imageRollbackCompatible": true
    }
  ]
}
