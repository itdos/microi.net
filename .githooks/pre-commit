#!/bin/sh
set -eu

MICROI_PUBLIC_GUARD_VERSION=3
export MICROI_PUBLIC_GUARD_VERSION
GIT_NO_REPLACE_OBJECTS=1
export GIT_NO_REPLACE_OBJECTS

repo_root=$(git --no-replace-objects rev-parse --show-toplevel)
policy_file="$repo_root/.public-repo-protected-paths"
canonical_paths='Microi.Server/Microi.net
Microi.Server/Microi.AI
Microi.VSCode
Microi.Client/src/views/webos
Microi.Server/Microi.WorkFlow
Microi.Server/Microi.Vision'

trusted_hook_oid() {
  case "$1" in
    .githooks/pre-commit) config_key='microi.publicGuard.preCommitOid' ;;
    .githooks/pre-push) config_key='microi.publicGuard.prePushOid' ;;
    *) return 1 ;;
  esac
  git --no-replace-objects config --local --get "$config_key"
}

validate_hook_integrity() {
  for hook_path in .githooks/pre-commit .githooks/pre-push; do
    expected_oid=$(trusted_hook_oid "$hook_path") || {
      echo "拒绝提交：本机未钉住 $hook_path 的可信 blob OID；请先执行闭源门禁初始化。" >&2
      exit 1
    }
    staged_oid=$(git --no-replace-objects rev-parse --verify ":$hook_path" 2>/dev/null) || {
      echo "拒绝提交：暂存区缺少 $hook_path。" >&2
      exit 1
    }
    worktree_oid=$(git --no-replace-objects hash-object --path="$hook_path" "$repo_root/$hook_path" 2>/dev/null) || {
      echo "拒绝提交：工作树缺少 $hook_path。" >&2
      exit 1
    }
    if [ "$staged_oid" != "$expected_oid" ] || [ "$worktree_oid" != "$expected_oid" ]; then
      echo "拒绝提交：$hook_path 与本机钉住的可信门禁不一致。" >&2
      exit 1
    fi
  done
}

reject_rewrite_overlays() {
  if git --no-replace-objects for-each-ref --format='%(refname)' refs/replace/ | grep -q .; then
    echo "拒绝提交：检测到 refs/replace，闭源路径审计不能在替换对象下运行。" >&2
    exit 1
  fi

  grafts_file=$(git --no-replace-objects rev-parse --git-path info/grafts)
  if [ -s "$grafts_file" ]; then
    echo "拒绝提交：检测到非空 info/grafts，闭源路径审计不能在 grafts 下运行。" >&2
    exit 1
  fi
}

validate_policy_file() {
  staged_policy_temp=$(mktemp "${TMPDIR:-/tmp}/microi-public-policy.XXXXXX")
  trap 'rm -f "$staged_policy_temp"' EXIT HUP INT TERM

  if ! git --no-replace-objects show :.public-repo-protected-paths > "$staged_policy_temp" 2>/dev/null; then
    echo "拒绝提交：暂存区缺少根公开仓闭源路径策略 $policy_file" >&2
    exit 1
  fi

  policy_paths=$(sed -e 's/\r$//' -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "$staged_policy_temp")
  rm -f "$staged_policy_temp"
  trap - EXIT HUP INT TERM
  if [ "$policy_paths" != "$canonical_paths" ]; then
    echo "拒绝提交：暂存区的 .public-repo-protected-paths 必须完整、逐字保留六条闭源路径。" >&2
    exit 1
  fi
}

filter_protected_paths() {
  LC_ALL=C perl -0ne '
    BEGIN {
      @protected = (
        "microi.server/microi.net",
        "microi.server/microi.ai",
        "microi.vscode",
        "microi.client/src/views/webos",
        "microi.server/microi.workflow",
        "microi.server/microi.vision"
      );
    }
    s/\0\z//;
    $original = $_;
    $candidate = lc $_;
    for $protected (@protected) {
      if ($candidate eq $protected || index($candidate, "$protected/") == 0) {
        $original =~ s/\\/\\\\/g;
        $original =~ s/\r/\\r/g;
        $original =~ s/\n/\\n/g;
        print "$original\n";
        last;
      }
    }
  '
}

reject_rewrite_overlays
validate_hook_integrity
validate_policy_file

tracked=$(git --no-replace-objects ls-files -z | filter_protected_paths)
if [ -n "$tracked" ]; then
  echo "拒绝提交：根仓索引包含独立闭源仓库路径（大小写不敏感匹配）：" >&2
  printf '%s\n' "$tracked" >&2
  echo "请只从根仓索引移除；不要删除内部 GitLab 工作区文件，也不要使用 --no-verify。" >&2
  exit 1
fi
